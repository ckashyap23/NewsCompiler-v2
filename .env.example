# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

# HTTP endpoint authentication (separate from the WhatsApp relay token)
BACKEND_API_TOKEN=replace-with-a-long-random-secret

# LLM provider
# Use "openai" or "azure_openai".
LLM_PROVIDER=openai

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_TOPIC_MODEL=gpt-5
OPENAI_NEWSLETTER_MODEL=gpt-4o-mini

# Weekly digest (python -m weekly.digest)
WEEKLY_DIGEST_DAYS=7

# Gmail
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

#Whatsapp
API_PATH=
API_POST_PATH=
BEARER_TOKEN=

# Database — Supabase PostgreSQL
DATABASE_URL=

# Daily research (python -m daily.orchestrator)
RESEARCH_TOPIC=
RECIPIENT_EMAILS=recipient1@example.com recipient2@example.com
RECEIPENT_PHONE_NUMBERS=recipient1_phone recipient2_phone

# LinkedIn OAuth2 (for python -m weekly.digest LinkedIn posting)
LINKEDIN_API_VERSION=202610
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_SCOPES=
LINKEDIN_AUTHOR_URN=
# Paste a valid LinkedIn OAuth access token here.
LINKEDIN_ACCESS_TOKEN=
